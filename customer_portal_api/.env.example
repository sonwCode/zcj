PORTAL_APP_NAME=Customer Portal API
# 必填：JWT 签名密钥。留空或沿用旧默认值 change-me-in-production 时，
# 服务会生成随机密钥并持久化到数据库同目录的 .portal_jwt_secret。
# 多实例部署必须显式设置同一个值。
PORTAL_JWT_SECRET=
PORTAL_ADMIN_USERNAME=admin
# 必填：首次启动创建管理员所用的口令。留空会生成一次性随机口令并打印到启动日志。
PORTAL_ADMIN_PASSWORD=
PORTAL_ADMIN_EMAIL=admin@example.com
PORTAL_ACCESS_TOKEN_TTL_SECONDS=7200
PORTAL_REFRESH_TOKEN_TTL_SECONDS=2592000
# 默认不启用 CORS（同源部署）。前后端分离调试时显式列出来源，逗号分隔。
PORTAL_CORS_ORIGINS=
PORTAL_START_SOLVER=false

# 支付回调签名密钥。未配置密钥的渠道一律拒绝回调（403），防止伪造支付成功。
# 方式一：每渠道一个变量，PORTAL_PAYMENT_SECRET_<渠道大写>
PORTAL_PAYMENT_SECRET_MOCK=
# 方式二：集中映射 "渠道:密钥,渠道2:密钥2"
PORTAL_PAYMENT_CALLBACK_SECRETS=
# 仅本地调试可开启：允许未签名回调（危险，不要在生产开启）
PORTAL_PAYMENT_ALLOW_UNSIGNED_CALLBACKS=false
